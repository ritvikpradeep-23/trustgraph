{
  "manifest_version": 3,
  "name": "TrustGraph",
  "version": "0.2.2",
  "description": "Check a message you choose for scam signals. Only the verdict comes home: message text is never stored. It warns, never blocks.",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "TrustGraph",
    "default_popup": "ui/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "ui/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://mail.google.com/*",
    "https://www.facebook.com/*",
    "https://www.instagram.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "shared/constants.js",
        "shared/icons.js",
        "shared/design.js",
        "shared/ui.js",
        "shared/rules/normalize.js",
        "shared/rules/rules.js",
        "shared/rules/engine.js",
        "shared/verdict.js",
        "adapters/kit.js",
        "adapters/whatsapp/reader.js",
        "adapters/whatsapp/adapter.js",
        "content/chat-store.js",
        "content/panel.js",
        "content/core.js"
      ]
    },
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "shared/constants.js",
        "shared/icons.js",
        "shared/design.js",
        "shared/ui.js",
        "shared/rules/normalize.js",
        "shared/rules/rules.js",
        "shared/rules/engine.js",
        "shared/verdict.js",
        "adapters/kit.js",
        "adapters/gmail.js",
        "content/chat-store.js",
        "content/panel.js",
        "content/core.js"
      ]
    },
    {
      "matches": [
        "https://www.facebook.com/*"
      ],
      "js": [
        "shared/constants.js",
        "shared/icons.js",
        "shared/design.js",
        "shared/ui.js",
        "shared/rules/normalize.js",
        "shared/rules/rules.js",
        "shared/rules/engine.js",
        "shared/verdict.js",
        "adapters/kit.js",
        "adapters/meta-chat.js",
        "adapters/messenger.js",
        "content/chat-store.js",
        "content/panel.js",
        "content/core.js"
      ]
    },
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "shared/constants.js",
        "shared/icons.js",
        "shared/design.js",
        "shared/ui.js",
        "shared/rules/normalize.js",
        "shared/rules/rules.js",
        "shared/rules/engine.js",
        "shared/verdict.js",
        "adapters/kit.js",
        "adapters/meta-chat.js",
        "adapters/instagram.js",
        "content/chat-store.js",
        "content/panel.js",
        "content/core.js"
      ]
    },
    {
      "matches": [
        "https://www.linkedin.com/*",
        "https://web.telegram.org/*",
        "https://discord.com/*",
        "https://ptb.discord.com/*",
        "https://canary.discord.com/*",
        "https://app.slack.com/*"
      ],
      "js": [
        "shared/constants.js",
        "shared/icons.js",
        "shared/design.js",
        "shared/ui.js",
        "shared/rules/normalize.js",
        "shared/rules/rules.js",
        "shared/rules/engine.js",
        "shared/verdict.js",
        "adapters/kit.js",
        "adapters/config.js",
        "adapters/sites.js",
        "content/chat-store.js",
        "content/panel.js",
        "content/core.js"
      ]
    },
    {
      "matches": [
        "http://localhost:5500/*"
      ],
      "js": [
        "shared/constants.js",
        "shared/icons.js",
        "shared/design.js",
        "shared/ui.js",
        "shared/rules/normalize.js",
        "shared/rules/rules.js",
        "shared/rules/engine.js",
        "shared/verdict.js",
        "adapters/kit.js",
        "adapters/stub.js",
        "content/chat-store.js",
        "content/panel.js",
        "content/core.js"
      ]
    }
  ],
  "optional_permissions": [
    "notifications"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.woff2"
      ],
      "matches": [
        "<all_urls>"
      ],
      "use_dynamic_url": true
    }
  ]
}
